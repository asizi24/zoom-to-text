# ══════════════════════════════════════════════════════════════
#  Zoom Transcriber — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env or key.json to git!
# ══════════════════════════════════════════════════════════════

# ── Google AI (choose one option) ─────────────────────────────
# Option A: Gemini API Key (easier, free tier available)
# Get it at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Option B: GCP Service Account key file path
# (Used for Vertex AI — if you have key.json, leave this as-is)
GOOGLE_APPLICATION_CREDENTIALS=key.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Gemini model to use (gemini-2.5-flash is recommended for new API keys)
GEMINI_MODEL=gemini-2.5-flash

# ── Whisper settings (for WHISPER_LOCAL mode only) ─────────────
# Model sizes: tiny | base | small | medium | large-v3
# Memory needed: tiny~400MB | medium~2GB | large-v3~4GB
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── Resource management ────────────────────────────────────────
# Unload Whisper from RAM after N idle minutes (saves memory)
AUTO_SHUTDOWN_IDLE_MINUTES=30

# ── App settings ───────────────────────────────────────────────
# Deployment stage: development | production.
# production disables the dev login bypass below and REQUIRES a real
# RESEND_API_KEY (startup fails otherwise, so login tokens never hit the logs).
ENVIRONMENT=development

# Log output format: text (human-readable, default) | json (for aggregation).
# docker-compose already sets json inside the container.
LOG_FORMAT=text

# Your server's public URL (used by the Chrome extension)
# Local:      http://localhost:8000
# EC2:        http://your-ec2-ip
# With domain: https://yourdomain.com
BASE_URL=http://localhost:8000

# ── Auth (magic link login) ────────────────────────────────────
# Comma-separated whitelist of emails allowed to log in
ALLOWED_EMAILS=you@example.com

# Resend API key for sending magic link emails (https://resend.com)
# LOCAL DEV BYPASS (development only): leave empty (or set a placeholder like
# "dummy") and the magic link is printed to the terminal instead of emailed —
# copy-paste it to log in while developing offline. Real keys start with "re_".
# With ENVIRONMENT=production this bypass is disabled and a real key is required.
RESEND_API_KEY=

# Session-cookie Secure flag. Leave unset for the default heuristic
# (secure unless BASE_URL starts with http://localhost). Set false when
# serving over plain http on a trusted LAN, true behind an https proxy.
# COOKIE_SECURE=false

# ── Download URL policy (SSRF guard) ───────────────────────────
# Reject submitted URLs whose host is/resolves to a private, loopback, or
# link-local address (a link can't be used to probe the LAN or the server).
BLOCK_PRIVATE_DOWNLOAD_TARGETS=true
# Optional host allowlist (comma-separated, suffix match). Empty = any public host.
# ALLOWED_DOWNLOAD_HOSTS=zoom.us

# ── Rate limiting (per client IP, in-process) ──────────────────
RATE_LIMIT_ENABLED=true
# Magic-link requests per minute (each one sends an email)
RATE_LIMIT_AUTH_PER_MINUTE=5
# Task submissions per minute (create / upload / retry — heavy pipeline work)
RATE_LIMIT_TASKS_PER_MINUTE=10
