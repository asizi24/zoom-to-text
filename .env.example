# ══════════════════════════════════════════════════════════════
#  Zoom Transcriber — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env or key.json to git!
# ══════════════════════════════════════════════════════════════

# ── Google AI (choose one option) ─────────────────────────────
# Option A: Gemini API Key (easier, free tier available)
# Get it at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Option B: GCP Service Account key file path
# (Used for Vertex AI — if you have key.json, leave this as-is)
GOOGLE_APPLICATION_CREDENTIALS=key.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Gemini model to use
GEMINI_MODEL=gemini-2.5-flash

# ── OpenAI (optional — only needed for WHISPER_API mode) ──────
OPENAI_API_KEY=

# ── LLM Provider Selection ────────────────────────────────────
# Which LLM handles summarization, critique, chat, flashcards,
# podcast, tutor, etc. Options: gemini | openrouter | ollama
LLM_PROVIDER=gemini

# OpenRouter (https://openrouter.ai) — only if LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (https://ollama.com) — local model runner. Not on Fly.io.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# ── Whisper (for WHISPER_LOCAL / WHISPER_API modes) ──────────
# Local model sizes: tiny | base | small | medium | large-v3
# Memory: tiny ~400MB | medium ~2GB | large-v3 ~4GB
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Hebrew-tuned ivrit-ai model (CT2, faster-whisper compatible)
IVRIT_AI_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2

# ── Auth ──────────────────────────────────────────────────────
# Comma-separated emails allowed to log in via magic link.
# Example: ALLOWED_EMAILS=alice@example.com,bob@example.com
ALLOWED_EMAILS=
# Admins bypass per-user 24h quotas and per-IP rate limits.
ADMIN_EMAILS=
# Resend.com API key for magic-link emails.
RESEND_API_KEY=
# Allowed CORS origin — set to your public domain in production.
CORS_ORIGIN=http://localhost:8000

# ── Content language ──────────────────────────────────────────
# "auto" — Gemini detects the lecture language.
# ISO 639-1 code ("he", "en", "ar", "fr"…) — force a language.
LECTURE_LANGUAGE=auto

# ── Diarization ──────────────────────────────────────────────
ENABLE_DIARIZATION=true
# gemini (text-based, default) | pyannote (acoustic; home-server only)
DIARIZATION_PROVIDER=gemini
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
# HuggingFace token (required for Pyannote — accepts model license)
HF_TOKEN=

# ── Exam quality pipeline ────────────────────────────────────
ENABLE_EXAM_CRITIQUE=true
EXAM_CRITIQUE_THRESHOLD=3.8

# ── WebSocket streaming (home-server only) ───────────────────
# NEVER enable on Fly.io — the shared-cpu-1x machine cannot
# sustain concurrent WebSocket connections + a loaded Whisper model.
ENABLE_STREAMING=false

# ── Rate limiting ────────────────────────────────────────────
# Per-IP task submissions per minute. Set 0 to disable.
RATE_LIMIT_PER_MINUTE=10
# Per-user task submissions per 24h. Set 0 to disable.
USER_DAILY_TASK_LIMIT=2

# ── Paths (override on Fly.io: DATA_DIR=/data) ───────────────
DATA_DIR=data

# ── Resource management ──────────────────────────────────────
# Unload Whisper from RAM after N idle minutes.
AUTO_SHUTDOWN_IDLE_MINUTES=30
# Max audio upload size in bytes (default 600 MB).
MAX_UPLOAD_BYTES=629145600

# ── App ──────────────────────────────────────────────────────
APP_TITLE=Zoom Transcriber
# Your server's public URL (used by the Chrome extension)
BASE_URL=http://localhost:8000
# Set ENABLE_DOCS=false on production to hide /docs and /redoc.
ENABLE_DOCS=true

# ── LLM debugging ────────────────────────────────────────────
# When true, persist raw LLM responses (50KB+ per task).
LLM_DEBUG_RAW_RESPONSES=false

# ── LTI 1.3 (institutional SSO) ──────────────────────────────
# OIDC state TTL (seconds) for login → launch handshake.
LTI_STATE_TTL_SECONDS=300
