# ── Secrets — NEVER bake .env into the image ──────────────────
.env
*.pem
key.json

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# ── Virtual environments ───────────────────────────────────────
.venv/
venv/
env/

# ── Data & runtime files (mounted as Docker volumes) ──────────
data/
downloads/
uploads/
*.db
*.log

# ── Git & CI ───────────────────────────────────────────────────
.git/
.github/
.gitignore

# ── IDE & OS ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Legacy & test files ────────────────────────────────────────
_legacy_archive/
tests/
test_*.py
verify_*.py
demo_*.py

# ── Not part of the server image ───────────────────────────────
# Chrome extension is distributed separately; never served by the app
extension/
models/

# ── Docs ──────────────────────────────────────────────────────
README.md

# requirements*.txt MUST be included (Dockerfile COPY depends on them)
!requirements.txt
!requirements-gpu.txt
